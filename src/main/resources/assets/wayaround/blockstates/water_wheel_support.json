{
  "multipart": [
    {
      "apply": {
        "model": "wayaround:block/water_wheel_support_core"
      }
    },
    {
      "when": { "north": "true" },
      "apply": { "model": "wayaround:block/water_wheel_support_arm", "uvlock": true }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "wayaround:block/water_wheel_support_arm", "y": 90, "uvlock": true }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "wayaround:block/water_wheel_support_arm", "y": 180, "uvlock": true }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "wayaround:block/water_wheel_support_arm", "y": 270, "uvlock": true }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "wayaround:block/water_wheel_support_arm", "x": 270, "uvlock": true }
    },
    {
      "when": { "down": "true" },
      "apply": { "model": "wayaround:block/water_wheel_support_arm", "x": 90, "uvlock": true }
    }
  ]
}
